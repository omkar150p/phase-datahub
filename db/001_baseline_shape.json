{
  "block_head_observations": {
    "type": "r",
    "columns": [
      ["response_id","bigint",true,"","",null],
      ["source_id","integer",true,"","",null],
      ["tag","text",true,"","",null],
      ["height","numeric(20,0)",true,"","",null],
      ["hash","text",true,"","",null],
      ["block_timestamp_secs","numeric(20,0)",true,"","",null]
    ],
    "indexes": [
      ["block_head_observations_pkey","btree",true,true,null,["response_id"]],
      ["heads_by_source_tag","btree",false,true,null,["source_id","tag","response_id"]]
    ],
    "constraints": [
      ["block_head_observations_block_timestamp_secs_check","c","CHECK ((block_timestamp_secs >= (0)::numeric))",true],
      ["block_head_observations_hash_check","c","CHECK ((hash ~ '^0x[0-9a-f]{64}$'::text))",true],
      ["block_head_observations_height_check","c","CHECK ((height >= (0)::numeric))",true],
      ["block_head_observations_pkey","p","PRIMARY KEY (response_id)",true],
      ["block_head_observations_source_id_fkey","f","FOREIGN KEY (source_id) REFERENCES sources(id)",true],
      ["block_head_observations_source_id_response_id_fkey","f","FOREIGN KEY (source_id, response_id) REFERENCES rpc_responses(source_id, id)",true],
      ["block_head_observations_tag_check","c","CHECK ((tag = ANY (ARRAY['latest'::text, 'finalized'::text])))",true]
    ]
  },
  "collector_checkpoints": {
    "type": "r",
    "columns": [
